# Copy this file to ".env" and paste your Anthropic API key.
# Get one at https://console.anthropic.com  (Settings → API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
PORT=3000

# Optional: URL of the standalone STT relay (see stt-relay/), for faster/more
# accurate streaming transcription than the browser's built-in engine.
# Local dev: ws://localhost:3002 (run `npm run dev` inside stt-relay/ too).
# Production: wss://<your-relay>.up.railway.app — leave blank to fall back to Web Speech.
STT_RELAY_URL=

# Required: durable storage for your thoughts/profile/prefs (kv_store table).
# Project Settings → API in your Supabase dashboard.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxx
